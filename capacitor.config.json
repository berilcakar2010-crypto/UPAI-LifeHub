{
  "appId": "com.beril.upailifehub",
  "appName": "UPAI LifeHub",
  "webDir": "build",
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#4ade80"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0f1814",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
